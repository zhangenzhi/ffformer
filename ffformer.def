Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%labels
    Author zhangenzhi
    Project FFFormer - ForestFormer3D
    Target H100 / CUDA 12.1 (sm_90 supported, compatible with CUDA 12.8 driver)

%files
    # Copy patch files into container for mmengine/mmdet3d patching
    replace_mmdetection_files /opt/replace_mmdetection_files

%environment
    export PATH=/opt/conda/bin:/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PYTHONPATH=/workspace
    export TORCH_CUDA_ARCH_LIST="9.0"

%post
    # Prevent interactive prompts during build
    export DEBIAN_FRONTEND=noninteractive
    ln -fs /usr/share/zoneinfo/UTC /etc/localtime

    # Ensure CUDA toolkit is on PATH for source builds (no GPU needed, just nvcc)
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export CUDA_HOME=/usr/local/cuda

    # ── pip network resilience ──────────────────────────────────────────
    export PIP_DEFAULT_TIMEOUT=120
    export PIP_RETRIES=5

    # ── System dependencies ─────────────────────────────────────────────
    apt-get update
    apt-get install -y ffmpeg libsm6 libxext6 git ninja-build libglib2.0-0 \
        libxrender-dev cmake wget curl
    apt-get install -y build-essential python3-dev python3-pip
    apt-get install -y --no-install-recommends libopenblas-dev

    # ── Install Miniconda ─────────────────────────────────────────────
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-py310_24.1.2-0-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    export PATH=/opt/conda/bin:$PATH

    # Fix conda compiler_compat that breaks numpy source builds
    rm -f /opt/conda/compiler_compat/ld

    # ── Install PyTorch 2.1.0 + CUDA 12.1 ────────────────────────────
    pip install torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 \
        --index-url https://download.pytorch.org/whl/cu121

    # ── Pin numpy and setuptools before OpenMMLab ───────────────────────
    pip install --only-binary=:all: numpy==1.24.4 setuptools

    # ── OpenMMLab stack (--no-deps to prevent dependency pollution) ────
    pip install mmcv==2.1.0 -f https://download.openmmlab.com/mmcv/dist/cu121/torch2.1/index.html
    pip install --no-deps mmengine==0.7.3
    pip install --no-deps mmdet==3.0.0
    pip install --no-deps mmsegmentation==1.0.0
    pip install --no-deps --no-build-isolation \
        git+https://github.com/open-mmlab/mmdetection3d.git@22aaa47fdb53ce1870ff92cb7e3f96ae38d17f61

    # ── Patch mmengine & mmdet3d ────────────────────────────────────────
    # Use pip show to locate packages (avoids import-time version checks)
    SITE_PACKAGES=$(pip show mmengine | grep "^Location:" | awk '{print $2}')
    MMENGINE_PATH="$SITE_PACKAGES/mmengine"
    MMDET3D_PATH="$SITE_PACKAGES/mmdet3d"
    cp /opt/replace_mmdetection_files/loops.py       "$MMENGINE_PATH/runner/loops.py"
    cp /opt/replace_mmdetection_files/base_model.py  "$MMENGINE_PATH/model/base_model/base_model.py"
    cp /opt/replace_mmdetection_files/transforms_3d.py "$MMDET3D_PATH/datasets/transforms/transforms_3d.py"
    echo "Patched mmengine and mmdet3d successfully"

    # ── MinkowskiEngine (H100 = sm_90) ──────────────────────────────────
    export TORCH_CUDA_ARCH_LIST="9.0"
    export MAX_JOBS=4
    export FORCE_CUDA=1
    export BLAS=openblas
    rm -rf /tmp/MinkowskiEngine
    cd /tmp
    git clone https://github.com/NVIDIA/MinkowskiEngine.git
    cd MinkowskiEngine
    git checkout 02fc608bea4c0549b0a7b00ca1bf15dee4a0b228
    # Patch for CUDA 12.x: thrust headers are no longer implicitly included
    # Add all required thrust includes to every .cu file at once
    for f in src/*.cu src/3rdparty/*.cuh; do
        [ -f "$f" ] && sed -i '1i #include <thrust/execution_policy.h>\n#include <thrust/sort.h>\n#include <thrust/unique.h>\n#include <thrust/remove.h>\n#include <thrust/reduce.h>\n#include <thrust/iterator/zip_iterator.h>\n#include <thrust/tuple.h>\n#include <thrust/system_error.h>' "$f"
    done
    python setup.py install --blas=openblas --force_cuda
    cd / && rm -rf /tmp/MinkowskiEngine

    # ── torch-scatter ───────────────────────────────────────────────────
    pip install torch-scatter -f https://data.pyg.org/whl/torch-2.1.0+cu121.html

    # ── torch-cluster ───────────────────────────────────────────────────
    pip install torch-cluster -f https://data.pyg.org/whl/torch-2.1.0+cu121.html

    # ── Reinstall numpy (binary) + scipy/numba before torch-points-kernels
    pip install --only-binary=:all: numpy==1.24.4
    pip install scipy==1.10.1 numba==0.57.0 llvmlite==0.40.0

    # ── torch-points-kernels (--no-deps: deps already installed above) ─
    pip install torch-points-kernels==0.7.0 --no-deps

    # ── spconv for CUDA 12.x (cu120 forward-compatible with 12.8 driver)
    pip install spconv-cu120==2.3.6

    # ── segmentator ─────────────────────────────────────────────────────
    rm -rf /tmp/segmentator
    git clone https://github.com/Karbo123/segmentator.git /tmp/segmentator
    cd /tmp/segmentator/csrc
    git reset --hard 76efe46d03dd27afa78df972b17d07f2c6cfb696
    # Force C++17 in CMakeLists.txt (required by PyTorch 2.1 headers)
    sed -i '/^project(/a set(CMAKE_CXX_STANDARD 17)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)' CMakeLists.txt
    mkdir build && cd build
    cmake .. \
        -DCMAKE_PREFIX_PATH=$(python -c 'import torch;print(torch.utils.cmake_prefix_path)') \
        -DPYTHON_INCLUDE_DIR=$(python -c "from distutils.sysconfig import get_python_inc; print(get_python_inc())") \
        -DPYTHON_LIBRARY=$(python -c "import distutils.sysconfig as sysconfig; import os; libdir=sysconfig.get_config_var('LIBDIR'); print(os.path.join(libdir, 'libpython3.10.so'))") \
        -DCMAKE_INSTALL_PREFIX=$(python -c 'from distutils.sysconfig import get_python_lib; print(get_python_lib())')
    make -j$(nproc)
    make install
    # Install Python module: .py files live at repo root (no segmentator/ subdir)
    # main.py imports from .csrc.build.libsegmentator, so recreate that structure
    SITE_PKG=$(python -c 'from distutils.sysconfig import get_python_lib; print(get_python_lib())')
    # make install may create a symlink pointing back to /tmp; remove it first
    rm -rf "$SITE_PKG/segmentator"
    mkdir -p "$SITE_PKG/segmentator/csrc/build"
    cp /tmp/segmentator/__init__.py /tmp/segmentator/main.py /tmp/segmentator/utils.py "$SITE_PKG/segmentator/"
    # The .so was built at /tmp/segmentator/csrc/build/libsegmentator.so
    cp /tmp/segmentator/csrc/build/libsegmentator.so "$SITE_PKG/segmentator/csrc/build/"
    touch "$SITE_PKG/segmentator/csrc/__init__.py" "$SITE_PKG/segmentator/csrc/build/__init__.py"
    cd /
    rm -rf /tmp/segmentator

    # ── Remaining Python packages ───────────────────────────────────────
    pip install \
        open3d==0.17.0 \
        plyfile==1.0.2 \
        laspy "laspy[lazrs]" \
        scikit-learn==1.2.2 \
        pandas==2.0.1 \
        matplotlib==3.5.2 \
        tensorboard==2.15.1 \
        trimesh==3.21.6 \
        addict==2.4.0 \
        yapf==0.33.0 \
        termcolor==2.3.0 \
        terminaltables==3.1.10 \
        pycocotools==2.0.6 \
        Shapely==1.8.5 \
        rich==13.3.5 \
        opencv-python-headless==4.7.0.72 \
        debugpy

    # ── Cleanup ─────────────────────────────────────────────────────────
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /opt/replace_mmdetection_files

%runscript
    exec python "$@"

%help
    FFFormer - ForestFormer3D Singularity Container
    PyTorch 2.1.0 + CUDA 12.1 + OpenMMLab + MinkowskiEngine
    Base: Ubuntu 22.04 (glibc 2.35) + CUDA 12.1.1 + cuDNN 8
    Target: H100 GPU (sm_90), compatible with CUDA 12.8 driver

    Build:
        singularity build --fakeroot ffformer.sif ffformer.def

    Train:
        singularity exec --nv --bind /path/to/ffformer:/workspace ffformer.sif \
            python /workspace/tools/train.py /workspace/configs/your_config.py \
            --work-dir /workspace/work_dirs/experiment1
